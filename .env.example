# Copy this file to .env and fill it in. .env is gitignored; never commit it.

# Twilio (console.twilio.com). A free trial account works: it can call verified numbers only.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15551234567

# OpenAI (platform.openai.com/api-keys). Needs access to the Realtime API.
OPENAI_API_KEY=

# Optional. Leave blank and, if cloudflared is installed (brew install cloudflared), Nag Me
# opens a free tunnel on startup and points your Twilio number at it. Set it only if you
# run your own tunnel or host.
PUBLIC_URL=

# Password for the dashboard.
ADMIN_PASSWORD=

# Optional. Set to any long random string to keep you signed in across restarts.
SECRET_KEY=

# Optional overrides.
# OPENAI_MODEL=gpt-realtime-mini
# OPENAI_VOICE=marin
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TEXT_MODEL=gpt-5.4-mini
# MAX_CALL_SECONDS=300
# TRANSCRIPT_RETENTION_DAYS=90
# ALLOW_REMOTE_DASHBOARD=0   # 1 to reach the dashboard through the tunnel (password still applies)
# DATABASE_PATH=nagme.db
# HOST=127.0.0.1
# PORT=8000
